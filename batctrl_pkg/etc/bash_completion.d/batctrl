# Bash completion for batctrl
_batctrl_completions()
{
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="-60 -70 -80 -90 -100 --current -c --toggle -t --help -h"
    COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
    return 0
}
complete -F _batctrl_completions batctrl

