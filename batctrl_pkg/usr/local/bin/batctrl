#!/usr/bin/env bash
# ----------------------------------------
# batctrl - Battery charge limit CLI utility
# Features:
# - Set: -60|-70|-80|-90|-100
# - --current
# - --toggle (80 <-> 100)
# - Auto-detect battery
# - Persist last value across reboot
# ----------------------------------------

set -e  # Fail fast on errors

# ---- REQUIRE ROOT ----
if [[ "$(id -u)" -ne 0 ]]; then
  echo "Error: batctrl must be run as root."
  echo "Usage: sudo batctrl --current"
  exit 1
fi

# ---- CONFIG ----
STATE_DIR="/var/lib/bat-limit"
STATE_FILE="$STATE_DIR/last_limit"

# Assume postinst already created these
if [[ ! -f "$STATE_FILE" ]]; then
  echo "State file missing. Reinstall package."
  exit 1
fi

# ---- AUTO-DETECT BATTERY ----
BATTERY_DIR=$(find /sys/class/power_supply/ -maxdepth 1 -name 'BAT*' -printf '%f\n' | head -n1)

if [[ -z "$BATTERY_DIR" ]]; then
    echo "No battery found."
    exit 1
fi

BATTERY_PATH="/sys/class/power_supply/$BATTERY_DIR/charge_control_end_threshold"

if [[ ! -f "$BATTERY_PATH" ]]; then
    echo "Battery charge control not supported."
    exit 1
fi

# ---- READ CURRENT VALUE ----
CURRENT=$(cat "$BATTERY_PATH")

# ---- ARG PARSING ----
case "$1" in

  --help|-h)
    echo "batctrl - Battery Charge Control"
    echo ""
    echo "Usage:"
    echo "  batctrl -60|-70|-80|-90|-100   Set charge limit"
    echo "  batctrl --current              Show current limit"
    echo "  batctrl --toggle               Toggle 80 <-> 100"
    echo "  batctrl --help                 Show this help"
    echo ""
    echo "Notes:"
    echo "  - Values must be between 60 and 100 in increments of 10"
    echo "  - Last value is automatically saved and restored on reboot"
    exit 0
    ;;

  --current|-c)
    echo "Current battery limit: $CURRENT%"
    exit 0
    ;;

  --toggle|-t)
    if [[ "$CURRENT" == "80" ]]; then
        TARGET=100
    elif [[ "$CURRENT" == "100" ]]; then
        TARGET=80
    else
        echo "Toggle only works at 80 or 100 (current: $CURRENT%)"
        exit 1
    fi
    ;;

  -*)
    VALUE="${1#-}"

    # Validate numeric
    if ! [[ "$VALUE" =~ ^[0-9]+$ ]]; then
        echo "Invalid input. Use -60|-70|-80|-90|-100"
        exit 1
    fi

    # Validate range
    if (( VALUE < 60 || VALUE > 100 )); then
        echo "Value must be between 60 and 100"
        exit 1
    fi

    # Validate step
    if (( VALUE % 10 != 0 )); then
        echo "Must be increments of 10"
        exit 1
    fi

    TARGET="$VALUE"
    ;;

  *)
    echo "Usage:"
    echo "  batctrl -60|-70|-80|-90|-100"
    echo "  batctrl --current"
    echo "  batctrl --toggle"
    exit 1
    ;;
esac

# ---- APPLY CHANGE ----
echo "$TARGET" > "$BATTERY_PATH"

NEW=$(cat "$BATTERY_PATH")

if [[ "$NEW" != "$TARGET" ]]; then
    echo "Failed to set battery limit (current: $NEW%)"
    exit 1
fi

echo "Battery limit set to $NEW%"

# ---- PERSIST VALUE ----
echo "$NEW" > "$STATE_FILE"

